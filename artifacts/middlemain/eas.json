{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.13.0",
      "pnpm": "10.26.1",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "sdk-54"
      },
      "ios": {
        "simulator": false,
        "image": "latest"
      }
    },
    "preview": {
      "node": "24.13.0",
      "pnpm": "10.26.1",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "middle-ma-in.replit.app",
        "EXPO_PUBLIC_GITHUB_APP_CLIENT_ID": "Iv23lizWSqwgviRUzGYF"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "android": {
        "image": "sdk-54",
        "buildType": "apk"
      }
    },
    "production": {
      "node": "24.13.0",
      "pnpm": "10.26.1",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "middle-ma-in.replit.app",
        "EXPO_PUBLIC_GITHUB_APP_CLIENT_ID": "Iv23lizWSqwgviRUzGYF"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "android": {
        "image": "sdk-54",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "serviceAccountKeyPath": "./google-services-account.json"
      }
    }
  }
}
