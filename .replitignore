# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local
/generated-artifacts/
/deliverables/
/attached_assets/
/.agents/
/.planning/
/.git/

# Keep local credentials, signing material, and release builds out of deploy images.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.mobileprovision
**/*.provisionprofile
**/credentials.json
**/google-services-account.json
**/*.apk
**/*.aab
**/*.ipa
