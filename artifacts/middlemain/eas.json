{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "oblivionhappier@icloud.com",
        "ascApiKeyPath": "/tmp/AuthKey.p8",
        "ascApiKeyId": "env:ASC_KEY_ID",
        "ascApiKeyIssuerId": "env:ASC_ISSUER_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services-account.json"
      }
    }
  }
}
