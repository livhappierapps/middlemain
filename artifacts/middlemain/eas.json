{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.13.0",
      "pnpm": "10.26.1",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "latest"
      }
    },
    "preview": {
      "node": "24.13.0",
      "pnpm": "10.26.1",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "c619b4d5-e3ec-47d4-a952-2fd41395511e-00-1c23pimrri8w9.worf.replit.dev"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "24.13.0",
      "pnpm": "10.26.1",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "c619b4d5-e3ec-47d4-a952-2fd41395511e-00-1c23pimrri8w9.worf.replit.dev"
      },
      "ios": {
        "buildConfiguration": "Release",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "oblivionhappier@icloud.com",
        "ascApiKeyPath": "/tmp/AuthKey.p8",
        "ascApiKeyId": "env:ASC_KEY_ID",
        "ascApiKeyIssuerId": "env:ASC_ISSUER_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services-account.json"
      }
    }
  }
}
